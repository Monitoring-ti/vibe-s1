# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Hermes AI API
HERMES_API_ENDPOINT=https://api.hermes.nousresearch.com/v1
HERMES_API_KEY=your-hermes-api-key
HERMES_MODEL=z-ai/glm-5.2

# OCR Configuration
OCR_LANGUAGE=spa

# File Limits
MAX_PDF_SIZE_MB=20

# Storage
STORAGE_BUCKET_NAME=charlas-pdfs
